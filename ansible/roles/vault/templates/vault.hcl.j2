# {{ ansible_managed }}
# ADR 0019: UI encendida, solo TLS, almacenamiento en archivo, sellado Shamir.

ui       = true
api_addr = "https://{{ vault_ip_publica }}:{{ vault_puerto }}"

# Vault bloquea su memoria para que los secretos descifrados nunca acaben en el
# disco de intercambio. El servicio de systemd del paquete ya le da el permiso.
disable_mlock = false

storage "file" {
  path = "{{ vault_dir_datos }}"
}

listener "tcp" {
  address         = "0.0.0.0:{{ vault_puerto }}"
  tls_cert_file   = "{{ vault_dir_tls }}/vault.crt"
  tls_key_file    = "{{ vault_dir_tls }}/vault.key"
  tls_min_version = "tls12"
}
